@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels;
@using Umbraco.Cms.Core.Models;
@{
	Layout = "mainLayout.cshtml";

    var title = Model.Value<string>("title");
    var text = Model.Value<string>("text");
    var buttonLink = Model.Value<IEnumerable<Link>>("buttonLink")?.FirstOrDefault();
    var buttonUrl = buttonLink?.Url ?? "/";
    var buttonText = !string.IsNullOrEmpty(buttonLink?.Name) ? buttonLink.Name : "Tillbaka till startsidan";
    var picture = Model.Value<IPublishedContent>("picture");
}

<main class="flex min-h-[70vh] flex-col items-center justify-center px-4 py-12 text-center">
    <div class="rounded-2xl bg-white max-w-2xl w-full flex flex-col items-center w-[800px] h-[600px] pt-5">
        
        @if (!string.IsNullOrEmpty(title))
        {
            <h1 class="text-2xl md:text-3xl font-bold text-gray-900 mb-4">@title</h1>
        }

        @if (!string.IsNullOrEmpty(text))
        {
            <p class="text-gray-600 mb-8 text-base md:text-lg">@text</p>
        }

        <a href="@buttonUrl" class="inline-flex items-center justify-center px-8 py-3 text-base font-medium text-white bg-[#061A57] hover:bg-[#0a267a] rounded-full transition-colors duration-200 mb-8">
            @buttonText
        </a>

        @if (picture != null)
        {
            <div class="flex justify-center mt-4">
                <img src="@picture.Url()" alt="@title" class="max-w-[300px] h-auto object-contain" />
            </div>
        }
    </div>
</main>