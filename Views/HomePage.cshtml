@using Umbraco.Cms.Web.Common.PublishedModels
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<HomePage>
@{ 
	Layout = "mainLayout.cshtml";

    var articleTitle = Model.Value<string>("articleTitle");
    var mainImage = Model.Value<IPublishedContent>("mainImage");
    var subheading = Model.Value<string>("subheading");

}
<div class="pl-4 pt-4 py-6 ">
    <div class="container mx-auto ">
        <div class="flex flex-col lg:flex-row gap-8">






            <!-- VÄNSTER SIDA: Artiklar -->
            <!-- RÖR EJ KOD -->
            <div class="w-full lg:w-2/3 flex flex-col gap-4">

                @foreach (var article in Model.Descendants<ArticlePage>().Where(x => x.ShowOnHomepage).OrderByDescending(x => x.CreateDate))
                {
                    <div class="bg-white w-full p-4 rounded-[12px] shadow-md">
                        <!-- 1. MainImage/Bild -->
                        <img src="@article.MainImage?.Url()" class="w-full h-56 object-cover mb-4 rounded-[12px]" />


                        <!-- 2. Title -->
                        <h2>
                            <a href="@article.Url()" class="text-[1.75rem] md:text-[2rem] lg:text-[2.5rem] font-bold leading-tight hover:underline">
                                @article.ArticleTitle</a>
                            </h2>


                        <!-- 3. Subheading/Underrubrik -->
                        <h5 class="text-black pt-2 text-[0.9rem] md:text-[1rem] lg:text-[1.2rem]">
                            @article.Subheading
                        </h5>
                    </div>              
                    }
                </div>
                <!-- RÖR EJ OVAN KOD -->
















            <!-- HÖGER SIDA: Senaste Nytt (Richard) -->
            <div class="w-full lg:w-1/3">
                @await Html.PartialAsync("Layout/_latestnews")
            </div>
        </div>
    </div>
</div>

