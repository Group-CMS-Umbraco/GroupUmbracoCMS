@using Umbraco.Cms.Web.Common.PublishedModels;
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
	Layout = null;
}



<!DOCTYPE html>
<html lang="sv">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>NordPunkt</title>
    <link href="~/css/output.css" rel="stylesheet" asp-append-version="true" /> <!-- Länkar allt i vår root/css med allt här-->
</head>
<body class="bg-[var(--color-page)] min-h-screen flex flex-col font-body text-text-main">
    <!-- Logga, navbar hamnar alltid överst -->
    <header>
        <partial name="Partials/Layout/_Header" />
    </header>


    <!-- Allt annat hamnar under renderbody -->
    <main>
        @RenderBody()
    </main>

    <!-- footer hamnar alltid längst ner -->
    <footer>
        <!-- footer -->
    </footer>

    <script src="~/js/form.js"></script>
</body>
</html> 