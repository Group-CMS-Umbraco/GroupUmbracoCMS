@using GroupUmbracoCMS.ViewModels
@using GroupUmbracoCMS.Controllers
@model NewstipFormViewModel

@{
    var success = TempData["NewstipSuccess"] is true;
    const string field = "w-full rounded border border-gray-300 bg-gray-100 px-3 text-base text-gray-900 outline-none " +
                         "focus:border-[#007BC1] focus:bg-white [&.input-validation-error]:border-red-400";
    const string label = "mb-1 block text-lg font-semibold text-gray-900";
    const string error = "mt-1 block text-xs text-red-500";
}

@if (success)
{
    <div role="status" class="mt-8 rounded border border-green-300 bg-green-50 p-4 text-sm text-green-800">
        Tack! Ditt tips har skickats till redaktionen.
    </div>
}
else
{
    using (Html.BeginUmbracoForm<FormController>(
        nameof(FormController.HandleNewstipForm),
        null,
        new { novalidate = "novalidate", id = "newstipForm", @class = "mt-6 space-y-3" }))
    {
        <div>

            <label asp-for="Email" class="@label">Email</label>
            <input asp-for="Email" type="email" class="@field h-10" />
            <span asp-validation-for="Email" class="@error"></span>

        </div>

        <div>

            <label asp-for="Category" class="@label">Ämne</label>
            <select asp-for="Category" required
                    class="@field h-10 py-2 invalid:text-text-muted [&>option]:text-text-main">
                <option value="" disabled hidden selected>Välj ett ämne</option>
                <option value="Nöje">Nöje</option>
                <option value="Kultur">Kultur</option>
                <option value="Sport">Sport</option>
            </select>
            <span asp-validation-for="Category" class="@error"></span>
            
        </div>

        <div>

            <label asp-for="Description" class="@label">Beskrivning</label>
            <textarea asp-for="Description" class="@field h-48 resize-y py-2"></textarea>
            <span asp-validation-for="Description" class="@error"></span>

        </div>

        <div class="pt-2">

            <div class="flex items-center gap-3">

                <input asp-for="AcceptTerms" type="checkbox"
                       class="h-8 w-8 shrink-0 cursor-pointer accent-[#0B1B57] [&.input-validation-error]:outline [&.input-validation-error]:outline-red-400" />
                <label asp-for="AcceptTerms" class="cursor-pointer text-base text-gray-800">
                    Jag godkänner villkoren och behandlingen av mina personuppgifter.
                </label>

            </div>

            <span asp-validation-for="AcceptTerms" class="@error"></span>

        </div>

        <button type="submit"
                class="mt-8 h-11 w-full rounded bg-[#0B1B57] text-lg font-semibold text-white hover:bg-[#00669f]">
            Skicka tips
        </button>
    }
}

