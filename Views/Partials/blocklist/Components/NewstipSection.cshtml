@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<Umbraco.Cms.Core.Models.Blocks.BlockListItem>
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels
@using GroupUmbracoCMS.ViewModels
@{
    var content = (ContentModels.NewstipSection)Model.Content;
}

<div class="mt-4">
    <h1 class="text-center text-3xl font-medium text-text-main">@content.NewstipSectionTitle</h1>
    <p class="mt-3 whitespace-pre-line text-sm leading-snug text-text-main">@content.NewstipSectionBody</p>
    <p class="mt-3 whitespace-pre-line text-sm leading-snug text-text-main">@content.NewstipSectionDescription</p>

    <partial name="~/Views/Partials/Forms/_NewstipForm.cshtml" model="new NewstipFormViewModel()" />

</div>
