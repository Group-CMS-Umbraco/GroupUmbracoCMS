@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<Umbraco.Cms.Core.Models.Blocks.BlockListItem>
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels
@using GroupUmbracoCMS.ViewModels

@{
    var content = (ContentModels.NewstipSection)Model.Content;
    var success = TempData["NewstipFormSuccess"] != null;
    var error = TempData["NewstipFormError"] != null;
}

@if (success || error)
{
    <div class="mx-auto mt-8 flex min-h-[358px] w-full max-w-[472px] flex-col items-center justify-center rounded-3xl bg-white px-6 py-12 text-center shadow-sm sm:mt-20 lg:mt-24 lg:min-h-[480px] lg:max-w-[640px]"
         role="@(error ? "alert" : "status")">
        <h1 class="text-2xl font-normal text-text-main lg:text-4xl">@(success ? "Tack!" : "OPS!")</h1>
        <p class="mt-6 max-w-[260px] text-base text-text-main lg:mt-8 lg:max-w-[340px] lg:text-lg">
            @(success
                ? "Vi har nu mottagit ditt tips!"
                : "Något gick fel när ditt formulär skulle skickas iväg. Vänligen försök igen senare.")
        </p>
        <a href="/"
           class="mt-10 inline-flex h-9 w-full max-w-[230px] items-center justify-center rounded-full bg-[#0B1B57] text-sm font-bold text-white shadow-md hover:opacity-90 lg:mt-12 lg:h-11 lg:max-w-[300px] lg:text-base">
            Tillbaka till startsidan
        </a>
    </div>
}
else
{
    <div class="mx-auto max-w-3xl rounded-xl bg-white px-4 py-8 shadow-sm sm:px-10">
        <div class="mx-auto max-w-[490px]">
            <img src="/media/2fujwsvz/nordpunktmini.svg" alt="" class="mx-auto h-20 w-auto sm:h-24" />
            <h1 class="mt-4 text-center text-3xl font-normal text-text-main">@content.NewstipSectionTitle</h1>
            <p class="mt-3 whitespace-pre-line text-sm leading-snug text-text-main">@content.NewstipSectionDescription</p>
            <partial name="Partials/Forms/_NewstipForm" model="new NewstipFormViewModel()" />
        </div>
    </div>
}
