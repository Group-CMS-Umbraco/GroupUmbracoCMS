@using Umbraco.Cms.Web.Common.PublishedModels;
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<ArticlePage>
@{
	Layout = "mainLayout.cshtml";
}

@* Content ArtikelPage. *@
<section>
	<article class="">
		<div>
			<h1>@Model.ArticleTitle</h1>
		</div>

		<div>
			@if (Model.AuthorImage != null)
			{
				<img src="@Model.AuthorImage.Url()" alt="Författarbild" />
			}

			<p>@Model.AuthorName</p>
		</div>

    
		@* CreateDate ändras till publiceringsdatum i Umbraco kanske? Jag ska kolla upp det sen. *@
		<div>
		
			<p>Publicerad: @Model.CreateDate.ToString("yyyy-MM-dd HH:mm")</p>
		</div>


		<div>
			@if (Model.MainImage != null)
			{
				<img src="@Model.MainImage.Url()" alt="Huvudbild" />
			}
        
			@if (!string.IsNullOrEmpty(Model.ImageCaption))
			{
				<p>@Model.ImageCaption</p>
			}
		</div>

		<div>
			@if (!string.IsNullOrEmpty(Model.Summary))
			{
				<p>@Model.Summary</p>
			}
		</div>

		@* Här används Rich Text Editor, så HTML-taggar behövs inte här. *@
		<div>
			@Model.BodyText
		</div>

	</article>


	@* Senaste nytt *@
	<aside>
		@* Senaste nytt *@
	</aside>

</section>