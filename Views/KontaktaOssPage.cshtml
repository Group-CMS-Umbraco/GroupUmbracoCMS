@using Umbraco.Cms.Web.Common.PublishedModels;
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<ContentModels.KontaktaOssPage>
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels;
@{
    Layout = "mainLayout.cshtml";

    var pageTitle = Model.Value<string>("pageTitle", defaultValue: "Kontakta Oss");
	var introText = Model.Value<string>("introText");
	var cards = Model.Value<IEnumerable<Umbraco.Cms.Core.Models.Blocks.BlockListItem>>("contactCards");
}

<section class="min-h-screen bg-gray-50/50 py-10 px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-10 md:p-12">

        <!-- Header: Rubrik & Introtext -->
        <header class="text-center max-w-2xl mx-auto mb-10 md:mb-12">
            <h1 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-[#0B2545] tracking-tight">
                @pageTitle
            </h1>
            @if (!string.IsNullOrWhiteSpace(introText))
            {
                <p class="mt-4 text-sm sm:text-base text-gray-700 leading-relaxed">
                    @introText
                </p>
            }
        </header>

        <!-- Grid Responsiv: 1 col på mobil, 2 col pe tablett/desktop -->
        <main class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6 ">
            @if (cards != null && cards.Any())
            {
                foreach (var block in cards)
                {
                    var card = block.Content;
                    var title = card.Value<string>("cardTitle");
                    var desc = card.Value<string>("cardDescription");
                    var line1 = card.Value<string>("contactLine1");
                    var line2 = card.Value<string>("contactLine2");
                    var line3 = card.Value<string>("contactLine3");

                    // Visar bilder/iconer från  Media Picker
                    var iconMedia = card.Value<Umbraco.Cms.Core.Models.PublishedContent.IPublishedContent>("cardIcon");

                    

                   <article class="bg-[#F8FAFC] border border-gray-100 
                     rounded-xl p-6 flex flex-col justify-between hover:shadow-md transition-shadow duration-200 
                    cursor-pointer hover:bg-sky-100"> 
                        <div>
                            <div class="flex items-center gap-3 mb-3">
                               
                                @if (iconMedia != null)     // Dinamiska Ikoner från Media Picker
                                {
                                    <img src="@iconMedia.Url()"
                                         alt=""
                                         aria-hidden="true"
                                         class="w-8 h-8 object-contain shrink-0" />
                                }
                                <h2 class="text-lg font-bold text-[#0B2545]">@title</h2>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(desc))
                            {
                                <p class="text-xs sm:text-sm text-gray-600 mb-4 leading-relaxed">
                                    @desc
                                </p>
                            }
                        </div>

                        <!--  Dinamiska linjer-->
                        <div class="pt-3 border-t border-gray-200/60 text-xs sm:text-sm text-gray-800 space-y-1 ">
                            
                            @if (!string.IsNullOrWhiteSpace(line1))                                      
                            {
                                <p class="leading-relaxed">@line1</p>
                            }
                            @if (!string.IsNullOrWhiteSpace(line2))
                            {
                                <p class="leading-relaxed"><a href ="tel:@line2" class="cursor-pointer">@line2</a></p>
                            }
                            @if (!string.IsNullOrWhiteSpace(line3))
                            {
                                <p class="leading-relaxed"><a href ="mailto:@line3" class="cursor-pointer">@line3</a></p>
                            }
                        </div>
                    </article>
                }
            }
        </main>
    </div>
</section>


<div> Kontakta oss sida </div>