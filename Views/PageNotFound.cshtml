@* Ärver basklassen UmbracoViewPage för att få full tillgång till egenskapen 'Model' (IPublishedContent) *@@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage@* Importerar namespace för genererade modeller från Umbraco Backoffice *@@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels;@using Umbraco.Cms.Core.Models;@{	Layout = "mainLayout.cshtml";    // Hämtar rubriken från Umbraco, med en säker fallback-text	var errorTitle = Model.Value<string>("errorTitle") ?? "Hoppsan - Vi kan inte hitta sidan!";	var buttonText = Model.Value<string>("buttonText") ?? "Tillbaka Till Startsidan";	var errorImage = Model.Value<IPublishedContent>("errorImage"); 
    var buttonLink = Model.Value<Link>("buttonLink");    // Null-conditional (?.) förhindrar NullReferenceException. Fallbackar till rotkatalogen (/) om ingen länk valts.    var buttonUrl = buttonLink?.Url ?? "/";     // Kontrollerar om redaktören har valt att öppna länken i ny flik (_blank). Annars används standard (_self).    var buttonTarget = !string.IsNullOrEmpty(buttonLink?.Target) ? buttonLink.Target : "_self";}
<main class="flex min-h-[90vh] flex-col items-center justify-center px-4 py-12 text-center">    <div class="max-w-2xl w-full flex flex-col items-center">
@* Responsiv rubrik:           - text-2xl på mobila enheter (grundstil)           - md:text-3xl förstorar rubriken på skärmar från 768px och uppåt           - mb-12 skapar ett tydligt avstånd ner till knappen *@        <h1 class="text-2xl md:text-3xl font-bold text-gray-900 mb-12">            @errorTitle        </h1>
<a href="@buttonUrl"           target="@buttonTarget"           class="inline-flex items-center justify-center px-12 py-4 text-base font-medium text-white bg-[#061A57] hover:bg-[#0a267a] rounded-full shadow-sm transition-colors duration-200">            @buttonText        </a>
@if (errorImage != null && !string.IsNullOrEmpty(errorImage.Url()))        {            <div class="mb-8 flex justify-center">                <img src="@errorImage.Url()"                      alt=""                      aria-hidden="true"                     class="max-w-[280px] md:max-w-[340px] h-auto object-contain" />            </div>        }        
</div></main>