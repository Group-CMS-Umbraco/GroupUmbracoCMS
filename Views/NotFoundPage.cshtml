@using Umbraco.Cms.Web.Common.PublishedModels;
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels;
@{
	Layout = "mainLayout.cshtml";

	var errorTitle = Model.Value<string>("errorTitle") ?? "Hoppsan - Vi kan inte hitta sidan!";
	var buttonText = Model.Value<string>("buttonText") ?? "Tillbaka Till Startsidan";
	var errorImage = Model.Value<IPublishedContent>("errorImage"); 
}

<main class="flex min-h-[60vh] flex-col items-center justify-center px-4 py-12 text-center">
    <div class="max-w-2xl w-full flex flex-col items-center">

        <h1 class="text-2xl md:text-3xl font-bold text-gray-900 mb-12">
            @errorTitle
        </h1>

        <a href="/"
           class="inline-flex items-center justify-center px-10 py-3 text-base font-medium text-white bg-[#061A57] hover:bg-[#0a267a] rounded-full shadow-sm transition-colors duration-200">
            @buttonText
        </a>


        @if (errorImage != null)
        {
            <img src="@errorImage.Url()"
                 alt="@errorTitle"
                 class="mb-8 max-w-[280px] md:max-w-[340px] h-auto object-contain" />
        }

        

        
    </div>
</main>