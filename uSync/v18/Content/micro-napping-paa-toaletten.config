  <Properties>
    <articleTitle>
      <Value><![CDATA[NYA TRENDEN: "Micro-napping" på toaletten under arbetstid ökar med 400%]]></Value>
    </articleTitle>
    <authorImage>
      <Value><![CDATA[[
  {
    "key": "629997a8-67d7-4970-bc9f-323056f5cd2e",
