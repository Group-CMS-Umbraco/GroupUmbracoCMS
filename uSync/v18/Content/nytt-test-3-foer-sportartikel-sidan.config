  <Properties>
    <articleTitle>
      <Value><![CDATA[HÄNT: Ännu ett test för en sport artikel! NORTHUG TILLBAKA PÅ TOPPEN – ÖVERLÄGSEN SEGER EFTER RYCKET]]></Value>
    </articleTitle>
    <authorImage>
      <Value><![CDATA[[
  {
    "key": "5e2a74b9-1331-483e-9ad8-2c58ce46f850",
